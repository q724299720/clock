APP_ENV=local
APP_DEBUG=true
APP_URL=https://clock.qiuxinmin.cn

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clock
DB_USERNAME=clock
DB_PASSWORD=replace-me

JWT_ISSUER=smartclock-php
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_APP_REFRESH_TOKEN_DAYS=36500
JWT_SECRET=replace-with-at-least-32-bytes-secret
JWT_REFRESH_PEPPER=replace-with-random-pepper

SMARTCLOCK_ADMIN_ACCOUNT=qxm@qxm.cn
SMARTCLOCK_ADMIN_PASSWORD=replace-with-strong-password
SMARTCLOCK_ADMIN_IS_EMAIL=true
